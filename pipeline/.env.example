# PRINTSYNC ETL Pipeline - environment template.
#
# Copy this file to .env and fill in the real values. Never commit .env.
#
# Two separate databases are involved, and they must never be confused:
#   * the SOURCE - PRINTSYNC's operational database. Reached with a READ-ONLY login.
#   * the TARGET - the pipeline's own database, psync_analytics.
# The pipeline never writes to the source (doc section 1.6).

# --- Source: PRINTSYNC (read-only) -------------------------------------------------
# A dedicated read-only login, encrypted with SSL (doc sections 1.2, 1.5 L7).
PSYNC_SOURCE_DSN=postgresql://readonly_user:CHANGE_ME@db.example.supabase.co:5432/postgres?sslmode=require

# --- Target: the pipeline's own database -------------------------------------------
PSYNC_TARGET_DSN=postgresql://psync_pipeline:CHANGE_ME@localhost:5432/psync_analytics

# --- Run parameters (doc sections 1.3, 4) ------------------------------------------
# Recorded on every run row.
PIPELINE_NAME=psync_nightly_analytics

# Business day to process, as YYYY-MM-DD.
# Leave unset for a scheduled run: it defaults to yesterday in RUN_TIMEZONE.
# BUSINESS_DATE=

# Trailing days re-read on every run, because some records change after their day has
# closed - a sale gets voided, for instance (doc section 1.3).
LOOKBACK_DAYS=3

# Time zone that defines the business-day boundary (doc sections 1.3, 2.6).
RUN_TIMEZONE=Asia/Manila

# The branch whose business_settings row supplies time_zone, vat_rate and currency_symbol
# (doc section 1.5 L5). The team chose the Balayan branch.
# Put the branch's code (branches.code) or its UUID here. Required - there is no silent
# fallback to another branch. Find the value with:
#   SELECT id, code, name FROM public.branches ORDER BY code;
REFERENCE_BRANCH=

# --- Connection behaviour (doc sections 1.5 L8, 7.1) -------------------------------
CONNECT_TIMEOUT_SECONDS=10
RETRY_COUNT=3
RETRY_BACKOFF_SECONDS=300
