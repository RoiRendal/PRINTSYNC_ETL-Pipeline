# A scratch issues folder at the repository root only. The rule used to be a bare `issues/`,
# which matched at any depth and silently ignored the tracked documentation in docs/issues/ as
# well as any new docs/<stage>/issues/ folder.
/issues/

# The Stage 1 issue texts are a local working set and are deliberately not published: the issues
# themselves live on GitHub, and their descriptions are the record. This rule names the path
# exactly, so docs/Transformation/issues/ stays tracked — a folder name is not a publishing
# decision, and ignoring one by name is how the Stage 1 files went missing in the first place.
docs/issues/

# Virtual environments
.venv/
venv/
env/

# Python build and cache artefacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# Secrets and local configuration - .env holds real credentials, .env.example does not
.env

# Prefect local state
.prefect/

# Pipeline output. Logs and the Parquet archive live on the pipeline host, never in the repo
# (doc section 5).
logs/
archive/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local assistant workspace notes (kept on disk, not part of the deliverable)
.workbuddy-ai/

# Pipeline output (doc section 9: logs and handover live on the host)
pipeline/logs/
pipeline/handover/
